# ─────────────────────────────────────────────────────────────────────────────
# ClipForge — backend environment template
#
# Copy this to a real `.env`. The backend loads it from the clipforge root
# (one level ABOVE this `clipper/` repo, i.e. ../.env relative to here) for
# local dev, or from /home/ubuntu/.env on the server. Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...                         # Whisper transcription + Llama analysis/fallback
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...                      # public anon key
SUPABASE_SERVICE_KEY=eyJ...                   # service_role key - server only, bypasses RLS

# ── Cloudflare R2 (clip storage) ─────────────────────────────────────────────
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=clipforge-clips

# ── App URL & CORS ───────────────────────────────────────────────────────────
APP_URL=https://clipforging.com               # used in emails + default CORS origin
# Comma-separated. Defaults to APP_URL + localhost:5173 + localhost:8000 if unset.
ALLOWED_ORIGINS=https://clipforging.com,http://localhost:5173,http://localhost:8000

# ── Optional - extra Groq keys for rate-limit rotation (GROQ_API_KEY_2..5) ────
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...

# ── Optional - OpenRouter (primary virality model; falls back to Groq Llama) ──
# Leave OPENROUTER_API_KEY unset to stay entirely on Groq.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openrouter/owl-alpha

# ── Optional - YouTube OAuth (upload clips to a creator''s channel) ───────────
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REDIRECT_URI=https://clipforging.com/api/youtube/callback

# ── Optional - YouTube Data API (per-clip analytics: views/likes/comments) ───
YOUTUBE_API_KEY=...

# ── Optional - TikTok cross-posting (Login Kit + Content Posting / Direct Post)
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_REDIRECT_URI=https://clipforging.com/api/tiktok/callback
# SELF_ONLY (private) is required while the app is unaudited. After TikTok
# approves production access, set to PUBLIC_TO_EVERYONE to post publicly.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ── Optional - email notifications (Resend) ──────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=ClipForge <notifications@updates.clipforging.com>

# ── Optional - Lemon Squeezy billing (Free → Pro subscriptions) ──────────────
# Leave unset to keep billing dormant (the /api/billing/* endpoints return 503).
LEMONSQUEEZY_API_KEY=...                       # Settings → API
LEMONSQUEEZY_STORE_ID=...                      # numeric store id
LEMONSQUEEZY_MONTHLY_VARIANT_ID=...            # variant id of the monthly Pro plan
LEMONSQUEEZY_ANNUAL_VARIANT_ID=...             # variant id of the annual Pro plan
LEMONSQUEEZY_WEBHOOK_SECRET=...                # signing secret set when creating the webhook

# ── Optional - yt-dlp cookies / bot bypass ───────────────────────────────────
# When set, yt-dlp reads live cookies from the browser profile (never expire).
# If unset, falls back to a cookies.txt file at the clipforge root.
COOKIES_FROM_BROWSER=chromium
# Sidecar PO-token service URL for YouTube bot-check bypass. Leave blank to disable.
POTTOKEN_URL=
