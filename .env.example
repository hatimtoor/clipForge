# ─── Required ────────────────────────────────────────────────────────────────

# Groq API key — get yours free at https://console.groq.com
GROQ_API_KEY=gsk_...

# Login credentials for the ClipForge web UI
CLIP_USER=admin
CLIP_PASS=yourpassword

# ─── YouTube cookies (pick one) ───────────────────────────────────────────────

# Option A (recommended for servers) — read live cookies from an installed browser
# Values: chromium, chrome, firefox, edge, safari
# COOKIES_FROM_BROWSER=chromium

# Option B (local dev) — export cookies to a cookies.txt file (Netscape format)
# and place it at the repo root. No env var needed; the app finds it automatically.

# ─── YouTube upload integration (optional) ───────────────────────────────────

# Create OAuth credentials at https://console.cloud.google.com
# Enable the YouTube Data API v3, then create OAuth 2.0 Client ID (Web application)
# YOUTUBE_CLIENT_ID=....apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=GOCSPX-...
# YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback

# ─── Advanced (optional) ─────────────────────────────────────────────────────

# bgutil PO token sidecar URL — only needed if YouTube blocks yt-dlp downloads
# See: https://github.com/nickmomrik/bgutil-ytdlp-pot-provider
# POTTOKEN_URL=http://localhost:4416
