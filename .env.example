# ─── Required ────────────────────────────────────────────────────────────────

# Groq API key — get yours free at https://console.groq.com
GROQ_API_KEY=gsk_...

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com → Project Settings → API

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ─── Cloudflare R2 (clip storage) ─────────────────────────────────────────────
# Create a bucket at https://dash.cloudflare.com → R2
# Then create an API token with Object Read & Write permissions

R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=clipforge-clips

# ─── Multiple Groq keys (optional) ────────────────────────────────────────────
# Add up to 4 extra keys — rotated automatically on rate limits

# GROQ_API_KEY_2=gsk_...
# GROQ_API_KEY_3=gsk_...
# GROQ_API_KEY_4=gsk_...
# GROQ_API_KEY_5=gsk_...

# ─── YouTube upload integration (optional) ────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com
# Enable YouTube Data API v3, create an OAuth 2.0 Client ID (Web application)

# YOUTUBE_CLIENT_ID=....apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=GOCSPX-...
# YOUTUBE_REDIRECT_URI=https://yourdomain.com/api/youtube/callback

# ─── YouTube Data API (optional — per-clip analytics) ─────────────────────────
# Create an API key at https://console.cloud.google.com → APIs & Services → Credentials

# YOUTUBE_API_KEY=AIza...

# ─── Email notifications (optional) ───────────────────────────────────────────
# Create a free account at https://resend.com

# RESEND_API_KEY=re_...
# APP_URL=https://yourdomain.com

# ─── YouTube cookies (optional — pick one) ────────────────────────────────────

# Option A (recommended for servers) — read live cookies from an installed browser
# Values: chromium, chrome, firefox, edge, safari
# COOKIES_FROM_BROWSER=chromium

# Option B — export cookies to a cookies.txt file (Netscape format)
# and place it at the repo root. No env var needed; the app finds it automatically.

# ─── Advanced (optional) ──────────────────────────────────────────────────────

# bgutil PO token sidecar URL — only needed if YouTube blocks yt-dlp downloads
# See: https://github.com/nickmomrik/bgutil-ytdlp-pot-provider
# POTTOKEN_URL=http://localhost:4416
