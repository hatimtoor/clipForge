# ClipForge — frontend (Vite) environment template
# Copy to `frontend/.env.local`. Only VITE_-prefixed vars are exposed to the
# browser, so never put the service_role key or any secret here.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
